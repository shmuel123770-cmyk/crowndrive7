# Netlify installs dependencies BEFORE the build command runs, so a bad registry here fails the
# build before `rm -rf package-lock.json` can help. The committed package-lock.json used to resolve
# every package from an internal Artifactory host that no external build server can reach
# (ETIMEDOUT); it is untracked now, and this pins the public registry so it cannot come back.
registry=https://registry.npmjs.org/
